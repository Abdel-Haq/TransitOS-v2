# Local development. Copy to .env — which is gitignored — and edit nothing to start.
#
# Every value here is a development value. `19-security-operations-delivery.md:57` allows
# local secrets ignored by version control and no production credentials; the config
# loader additionally refuses `env:` secret refs and the policy-set sentinel below in
# staging and production, so this file cannot be promoted by accident.

# --- The fifteen keys of 19-security-operations-delivery.md:63 -------------------------

ENVIRONMENT=local

# Same origin, both of them. The proxy routes / to web and /api to the API; the session
# cookie is HttpOnly and same-origin, and startup fails if these two origins differ.
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api

DATABASE_URL_REF=env:DATABASE_URL

OIDC_ISSUER=http://localhost:8080/identity/realms/dossier-clair
OIDC_CLIENT_ID=dossier-clair-web
OIDC_CLIENT_SECRET_REF=env:OIDC_CLIENT_SECRET

SESSION_KEY_REF=env:SESSION_KEY

OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=dossier-clair-documents
OBJECT_STORE_CREDENTIALS_REF=env:OBJECT_STORE_CREDENTIALS

SCANNER_ENDPOINT=http://localhost:3310

BUSINESS_TIMEZONE=Africa/Casablanca

# The sentinel. Staging and production reject it by name: 19-…:63 says do not
# auto-create production policies from local defaults.
APPROVED_POLICY_SET_ID=local-dev-unapproved

# ADR-002. `dev_single_approver` lets the submitter approve their own controlled action,
# which is the only way one person can develop against a two-person rule. Every such
# approval is stamped `self_approved: true` and surfaced in the audit export, and startup
# refuses this mode in staging and production.
APPROVAL_POLICY_MODE=dev_single_approver

# Optional modules (DF01–DF06). Empty means every one stays disabled, which is what
# 19-…:63 requires of an unconfigured optional module. Core modules are always on.
ENABLED_MODULES=

# --- Development secret values --------------------------------------------------------
# Referenced by the env: refs above. In staging and production these are files mounted
# from the deployment secret store, and env: refs are rejected outright.

POSTGRES_PASSWORD=dossier-clair-local
DATABASE_URL=postgres://dossier_clair:dossier-clair-local@localhost:5432/dossier_clair
OIDC_CLIENT_SECRET=dossier-clair-local-client-secret
SESSION_KEY=dossier-clair-local-session-key-change-me
OBJECT_STORE_CREDENTIALS=dossierclair:dossier-clair-local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dossier-clair-local
